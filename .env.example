# Server
PORT=8888
# Must exactly match a Redirect URI registered in your Spotify app.
# Spotify requires 127.0.0.1 (not "localhost") for local loopback URIs.
BASE_URL=http://127.0.0.1:8888

# Spotify — https://developer.spotify.com/dashboard
# Add redirect URI: http://127.0.0.1:8888/auth/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Apple Music — Apple Developer account > Certificates, IDs & Profiles > Keys
# Create a key with "Media Services (MusicKit)" enabled and download the .p8 file.
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Either a path to the .p8 file...
APPLE_PRIVATE_KEY_PATH=./AuthKey_XXXXXXXXXX.p8
# ...or the key contents inline (\n escapes allowed)
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
