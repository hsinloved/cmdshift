# Public URL of the app. Must match the Spotify redirect URI's origin.
# Local: Spotify requires 127.0.0.1 (not "localhost").
# Production: https://your-domain (not needed on Render — detected automatically).
BASE_URL=http://127.0.0.1:8888
PORT=8888

# Encrypts the login cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Spotify — https://developer.spotify.com/dashboard
# Redirect URI to register: <BASE_URL>/auth/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Apple Music — developer.apple.com > Certificates, IDs & Profiles > Keys
# (key with "Media Services (MusicKit)" enabled)
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Either a path to the .p8 file (with Docker, put it in ./secrets/)...
APPLE_PRIVATE_KEY_PATH=./secrets/AuthKey.p8
# ...or the key itself: PEM with \n escapes, or base64 of the .p8 file.
# APPLE_PRIVATE_KEY=
