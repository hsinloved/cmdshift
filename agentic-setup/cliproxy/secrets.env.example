# Copy to ~/.config/cliproxy/secrets.env and chmod 600. Never commit the real file.
# Client key: one of the api-keys in CLIProxyAPI's config.yaml.
CLIPROXY_API_KEY=
# Management key: remote-management.secret-key in config.yaml. Used by the
# status line and cliproxy-account; leave empty to hide the account list.
CLIPROXY_MANAGEMENT_KEY=
# Base URL of the proxy, same as ANTHROPIC_BASE_URL.
CLIPROXY_URL=https://your-proxy.example.ts.net
